{
  "name": "civi-mcp",
  "version": "0.1.1",
  "description": "Model Context Protocol server for CiviCRM (APIv4).",
  "keywords": [
    "apiv4",
    "civicrm",
    "claude",
    "mcp",
    "model-context-protocol"
  ],
  "homepage": "https://github.com/yo61/civi-mcp#readme",
  "bugs": {
    "url": "https://github.com/yo61/civi-mcp/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yo61/civi-mcp.git"
  },
  "bin": {
    "civi-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "CIVI_INTEGRATION=1 vitest run test/integration",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm verify && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.5.3"
}
